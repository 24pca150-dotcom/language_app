# ==========================================
# 1. COMPILED OUTPUT & BUILD ARTIFACTS
# ==========================================
/frontend/dist/
/tmp/
/out-tsc/
/bazel-out/

# Laravel-specific builds
/backend/public/build/
/backend/public/hot/
/backend/public/storage/

# ==========================================
# 2. DEPENDENCY FOLDERS
# ==========================================
/frontend/node_modules/
/backend/node_modules/
/backend/vendor/

# ==========================================
# 3. ENVIRONMENT & SENSITIVE FILES (CRITICAL)
# ==========================================
.env
.env.backup
.env.production
.env.local
.env.development
.env.test
.env.*.local
*.env

# Backend specific environment/secret files
/backend/.env
/backend/.env.backup
/backend/.env.production
/backend/.env.local
/backend/auth.json

# Laravel package keys & server keys
/backend/storage/*.key
/backend/storage/pail/

# ==========================================
# 4. LOGS, CACHE & TEMPORARY FILES
# ==========================================
# Angular CLI & compiler caches
/frontend/.angular/
.sass-cache/

# Lock files that shouldn't be tracked (if any)
/connect.lock

# Test outputs & coverage reports
/coverage/
/backend/.phpunit.result.cache
/backend/.phpunit.cache/
/backend/storage/framework/cache/data/
/backend/storage/framework/sessions/
/backend/storage/framework/views/
/backend/storage/logs/*.log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
testem.log

# ==========================================
